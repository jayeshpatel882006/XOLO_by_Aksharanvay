<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/xoloPaper">

    <com.aksharanvay.xolo.ui.view.AmbientPlaygroundView
        android:id="@+id/home_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/home_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="96dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/home_wordmark"
                style="@style/Text.Xolo.Wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_wordmark"
                android:textSize="68sp" />

            <TextView
                android:id="@+id/home_signature"
                style="@style/Text.Xolo.Signature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/brand_signature" />

            <TextView
                android:id="@+id/home_tagline"
                style="@style/Text.Xolo.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/tagline"
                android:textColor="?attr/xoloTextPrimary"
                android:textSize="19sp" />

            <Space
                android:layout_width="1dp"
                android:layout_height="48dp" />

            <com.aksharanvay.xolo.ui.view.TactileButton
                android:id="@+id/home_friend"
                android:layout_width="match_parent"
                android:layout_height="@dimen/xolo_mode_card_height" />

            <Space
                android:layout_width="1dp"
                android:layout_height="12dp" />

            <com.aksharanvay.xolo.ui.view.TactileButton
                android:id="@+id/home_computer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/xolo_mode_card_height" />

            <Space
                android:layout_width="1dp"
                android:layout_height="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.aksharanvay.xolo.ui.view.TactileButton
                    android:id="@+id/home_settings"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/xolo_small_button_height"
                    android:layout_weight="1" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <com.aksharanvay.xolo.ui.view.TactileButton
                    android:id="@+id/home_about"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/xolo_small_button_height"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_footer"
                style="@style/Text.Xolo.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:alpha="0.85"
                android:gravity="center"
                android:text="@string/home_footer" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
