<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/xoloPaper">

    <com.aksharanvay.xolo.ui.view.AmbientPlaygroundView
        android:id="@+id/settings_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="8dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp">

            <ImageButton
                android:id="@+id/settings_back"
                style="@style/Widget.Xolo.IconButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/settings_title"
                style="@style/Text.Xolo.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_title"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/settings_sub"
                style="@style/Text.Xolo.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_sub" />

            <TextView
                style="@style/Text.Xolo.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.12"
                android:text="@string/settings_section_feel" />

            <com.aksharanvay.xolo.ui.view.ToggleRowView
                android:id="@+id/settings_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <com.aksharanvay.xolo.ui.view.ToggleRowView
                android:id="@+id/settings_vibration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <TextView
                style="@style/Text.Xolo.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.12"
                android:text="@string/settings_section_look" />

            <com.aksharanvay.xolo.ui.view.SegmentedControl
                android:id="@+id/settings_theme"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/settings_theme_sub"
                style="@style/Text.Xolo.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/theme_sub" />

            <TextView
                style="@style/Text.Xolo.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.12"
                android:text="@string/settings_section_opponent" />

            <com.aksharanvay.xolo.ui.view.SegmentedControl
                android:id="@+id/settings_difficulty"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/settings_difficulty_sub"
                style="@style/Text.Xolo.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/difficulty_sub" />

            <com.aksharanvay.xolo.ui.view.TactileButton
                android:id="@+id/settings_reset"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="26dp" />

            <TextView
                android:id="@+id/settings_reset_sub"
                style="@style/Text.Xolo.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/reset_scores_sub" />

            <TextView
                android:id="@+id/settings_version"
                style="@style/Text.Xolo.Signature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
