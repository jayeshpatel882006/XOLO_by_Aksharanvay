<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/xoloOverlay"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/setup_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/bg_setup_card"
        android:elevation="20dp"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/setup_title"
                style="@style/Text.Xolo.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/setup_title" />

            <ImageButton
                android:id="@+id/setup_close"
                style="@style/Widget.Xolo.IconButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@string/cd_close"
                android:padding="11dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/setup_body"
            style="@style/Text.Xolo.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/setup_body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <com.aksharanvay.xolo.ui.view.TactileButton
                android:id="@+id/setup_x"
                android:layout_width="match_parent"
                android:layout_height="82dp" />

            <Space
                android:layout_width="1dp"
                android:layout_height="10dp" />

            <com.aksharanvay.xolo.ui.view.TactileButton
                android:id="@+id/setup_o"
                android:layout_width="match_parent"
                android:layout_height="82dp" />
        </LinearLayout>

        <TextView
            style="@style/Text.Xolo.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.1"
            android:text="@string/setup_difficulty" />

        <com.aksharanvay.xolo.ui.view.SegmentedControl
            android:id="@+id/setup_difficulty"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp" />

        <com.aksharanvay.xolo.ui.view.TactileButton
            android:id="@+id/setup_start"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/setup_cancel"
            style="@style/Text.Xolo.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/setup_close" />
    </LinearLayout>
</FrameLayout>
