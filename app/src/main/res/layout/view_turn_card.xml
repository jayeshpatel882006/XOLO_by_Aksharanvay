<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_turn_card"
    android:elevation="3dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <com.aksharanvay.xolo.ui.view.MarkGlyphView
        android:id="@+id/turn_mark"
        android:layout_width="54dp"
        android:layout_height="54dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/turn_title"
            style="@style/Text.Xolo.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/turn_subtitle"
            style="@style/Text.Xolo.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp" />
    </LinearLayout>

    <com.aksharanvay.xolo.ui.view.ThinkingIndicator
        android:id="@+id/turn_thinking"
        android:layout_width="52dp"
        android:layout_height="28dp"
        android:visibility="gone" />
</LinearLayout>
