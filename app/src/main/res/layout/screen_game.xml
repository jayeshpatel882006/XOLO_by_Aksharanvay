<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/xoloPaper">

    <com.aksharanvay.xolo.ui.view.AmbientPlaygroundView
        android:id="@+id/game_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/game_back"
                style="@style/Widget.Xolo.IconButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_back" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/game_mode"
                style="@style/Text.Xolo.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:textColor="?attr/xoloTextPrimary" />
        </LinearLayout>

        <com.aksharanvay.xolo.ui.view.ScoreStripView
            android:id="@+id/game_scores"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="6dp" />

        <include
            android:id="@+id/game_turn_card"
            layout="@layout/view_turn_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <FrameLayout
            android:id="@+id/board_holder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:minHeight="220dp">

            <com.aksharanvay.xolo.ui.view.BoardView
                android:id="@+id/game_board"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/game_status"
            style="@style/Text.Xolo.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:minHeight="28dp"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.aksharanvay.xolo.ui.view.TactileButton
                android:id="@+id/game_restart"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.aksharanvay.xolo.ui.view.TactileButton
                android:id="@+id/game_new"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/setup_overlay"
        layout="@layout/view_setup_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
